diff --git a/elixir/test/symphony_elixir/workspace_and_config_test.exs b/elixir/test/symphony_elixir/workspace_and_config_test.exs
index 15f7c36..d8e6aa8 100644
--- a/elixir/test/symphony_elixir/workspace_and_config_test.exs
+++ b/elixir/test/symphony_elixir/workspace_and_config_test.exs
@@ -987,6 +987,34 @@ defmodule SymphonyElixir.WorkspaceAndConfigTest do
     end
   end

+  test "required preservation hook blocks failed, interrupted, missing and recorded cleanup" do
+    root = Path.join(System.tmp_dir!(), "preservation-#{System.unique_integer([:positive])}")
+    on_exit(fn -> File.rm_rf(root) end)
+
+    for command <- ["exit 17", "sleep 1", nil] do
+      write_workflow_file!(Workflow.workflow_file_path(),
+        workspace_root: root,
+        hook_before_remove: command,
+        hook_timeout_ms: 10
+      )
+
+      path = Workflow.workflow_file_path()
+      File.write!(path, String.replace(File.read!(path), "hooks:\n", "hooks:\n  before_remove_required: true\n"))
+      assert {:ok, workspace} = Workspace.create_for_issue("KEEP")
+      File.write!(Path.join(workspace, "evidence"), "original")
+      assert {:error, _, _} = Workspace.remove(workspace)
+      assert {:error, _, _} = Workspace.remove_recorded(workspace, nil)
+      assert :ok = Workspace.remove_issue_workspaces("KEEP")
+      assert File.read!(Path.join(workspace, "evidence")) == "original"
+    end
+
+    write_workflow_file!(Workflow.workflow_file_path(), workspace_root: root, hook_before_remove: "test -f evidence")
+    path = Workflow.workflow_file_path()
+    File.write!(path, String.replace(File.read!(path), "hooks:\n", "hooks:\n  before_remove_required: true\n"))
+    assert {:ok, _} = Workspace.remove(Path.join(root, "KEEP"))
+    refute File.exists?(Path.join(root, "KEEP"))
+  end
+
   test "config reads defaults for optional settings" do
     previous_linear_api_key = System.get_env("LINEAR_API_KEY")
     on_exit(fn -> restore_env("LINEAR_API_KEY", previous_linear_api_key) end)
