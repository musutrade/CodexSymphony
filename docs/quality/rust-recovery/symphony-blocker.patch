+  test "explicit blockers stop the runner and persist without retrying after restart" do
+    configure!()
+    Application.put_env(:symphony_elixir, :github_client_module, FakeClient)
+
+    declaration = %{
+      "status" => "blocked",
+      "issue_id" => "42",
+      "repo" => handoff()["repo"],
+      "reason" => "required collector unsupported",
+      "evidence" => "target/blocker.json",
+      "resume_condition" => "reviewed collector installed"
+    }
+
+    assert {:error, {:agent_blocked, _, _, _} = reason} = Client.validate_handoff(issue(), declaration, settings())
+
+    for changes <- [%{"issue_id" => "wrong"}, %{"repo" => "wrong/repo"}, %{"reason" => ""}, %{"evidence" => String.duplicate("x", 2049)}, %{"number" => 17}] do
+      assert {:error, :invalid_blocker_declaration} = Client.validate_handoff(issue(), Map.merge(declaration, changes), settings())
+    end
+
+    {:ok, workspace} = Workspace.create_for_issue(issue())
+    File.write!(Path.join(workspace, ".symphony-handoff.json"), Jason.encode!(declaration))
+    assert :ok = AgentRunner.run(issue(), self())
+    assert_receive {:agent_handoff_error, _, "42", ^reason}
+    name = Module.concat(__MODULE__, :ExplicitBlock)
+    pid = start_supervised!({Orchestrator, name: name})
+    {ref, worker} = running(pid)
+
+    :sys.replace_state(pid, fn state ->
+      entry = %{
+        issue_id: "42",
+        identifier: "GH-42",
+        issue: issue(),
+        phase: "implementing",
+        handoff: %{},
+        serial_policy: handoff()["policy"],
+        budget: SymphonyElixir.AgentBudget.normalize(%{}),
+        waiting_since: DateTime.utc_now(),
+        repairs: 0,
+        error: nil,
+        next_poll_at: 0,
+        worker_host: nil,
+        workspace_path: workspace,
+        session_id: nil
+      }
+
+      %{state | waiting: %{"42" => entry}}
+    end)
+
+    send(pid, {:agent_handoff_error, worker, "42", reason})
+    send(pid, {:DOWN, ref, :process, worker, :normal})
+    state = :sys.get_state(pid)
+    assert state.waiting["42"].phase == "blocked"
+    assert state.waiting["42"].error =~ "required collector unsupported"
+    assert state.retry_attempts == %{}
+    assert state.running == %{}
+    stop_supervised!(Orchestrator)
+    restarted = start_supervised!({Orchestrator, name: name})
+    assert :sys.get_state(restarted).waiting["42"].phase == "blocked"
+    assert :sys.get_state(restarted).retry_attempts == %{}
